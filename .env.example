# Copie en .env pour `netlify dev`. En production, ces valeurs vont dans
# Netlify > Project configuration > Environment variables.
STEAM_API_KEY=
STEAM_ID=
SYNC_TOKEN=
SYNC_TIMEZONE=America/Toronto
# Au moins l'un des deux : le cookie _backloggd_session, ou identifiant + mot de passe.
BACKLOGGD_SESSION=
BACKLOGGD_USERNAME=
BACKLOGGD_PASSWORD=
